# API
OPENAI_API_KEY=
TRANSACTION_CLASSIFIER_MODEL=gpt-5.6-terra

# Optional when running API outside docker-compose
DATABASE_URL=postgresql://underwriting:underwriting_dev@localhost:5432/underwriting
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_ROOT=./var/uploads
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# S3-compatible production storage example
# OBJECT_STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# AWS_REGION=ca-central-1
# S3_PREFIX=underwriting
# S3_ENDPOINT_URL=
# S3_SERVER_SIDE_ENCRYPTION=AES256
